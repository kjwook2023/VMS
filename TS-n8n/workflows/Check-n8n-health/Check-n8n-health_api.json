                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "WITH LatestData AS (\n    SELECT TOP 1 CollectionTime\n    FROM TsMgmt.dbo.ServerHealthLog\n    ORDER BY CollectionTime DESC\n),\nTimeCheck AS (\n    SELECT\n        GETDATE() AS CurrentQueryTime,\n        DATEADD(HOUR, -8, GETDATE()) AS EightHoursAgoTime\n)\nSELECT\n    CONVERT(VARCHAR, T.CurrentQueryTime, 120) AS CurrentQueryTime,\n    CONVERT(VARCHAR, T.EightHoursAgoTime, 120) AS EightHoursAgoTime,\n    CASE\n        WHEN LD.CollectionTime IS NOT NULL\n             AND LD.CollectionTime \u003e= T.EightHoursAgoTime\n        THEN 1\n        ELSE 0\n    END AS DataExists,\n    CONVERT(VARCHAR, LD.CollectionTime, 120) AS LatestCollectionTime\nFROM LatestData AS LD\nCROSS JOIN TimeCheck AS T"
                                     },
