                                         "jsCode":  "const items = $input.all();\n\nconst nowText = new Intl.DateTimeFormat(\u0027sv-SE\u0027, {\n  timeZone: \u0027Asia/Seoul\u0027,\n  year: \u0027numeric\u0027,\n  month: \u00272-digit\u0027,\n  day: \u00272-digit\u0027,\n  hour: \u00272-digit\u0027,\n  minute: \u00272-digit\u0027,\n  second: \u00272-digit\u0027,\n  hour12: false,\n}).format(new Date()) + \u0027 KST\u0027;\n\nconst validPrs = items\n  .map((item) =\u003e item.json ?? {})\n  .filter((pr) =\u003e pr.html_url \u0026\u0026 pr.title \u0026\u0026 pr.user?.login \u0026\u0026 pr.user.login !== \u0027dependabot[bot]\u0027);\n\nif (validPrs.length === 0) {\n  return [{\n    json: {\n      prCount: 0,\n      repository: \u0027vmslab/Mozart2.0\u0027,\n      checkTime: nowText,\n      slackText: \u0027\\uD83C\\uDF89 \\uD604\\uC7AC \\uB300\\uAE30 \\uC911\\uC778 Pull Request\\uAC00 \\uC5C6\\uC2B5\\uB2C8\\uB2E4! (\\uBD07 \\uC81C\\uC678)\u0027,\n      teamsTitle: \u0027GitHub PR \\uBAA8\\uB2C8\\uD130\\uB9C1\u0027,\n      teamsSummary: \u0027\\uD604\\uC7AC \\uB300\\uAE30 \\uC911\\uC778 Pull Request\\uAC00 \\uC5C6\\uC2B5\\uB2C8\\uB2E4. (\\uBD07 \\uC81C\\uC678)\u0027,\n      teamsDetails: \u0027\u0027,\n    },\n  }];\n}\n\nconst slackLines = [];\nconst teamsLines = [];\n\nfor (const [index, pr] of validPrs.entries()) {\n  const reviewerNames = Array.isArray(pr.requested_reviewers) \u0026\u0026 pr.requested_reviewers.length \u003e 0\n    ? pr.requested_reviewers.map((reviewer) =\u003e reviewer.login).join(\u0027, \u0027)\n    : \u0027\\uC9C0\\uC815\\uB418\\uC9C0 \\uC54A\\uC74C\u0027;\n\n  slackLines.push(\u0027\\u2022 \u003c\u0027 + pr.html_url + \u0027|\u0027 + pr.title + \u0027\u003e\\n  \\uC791\\uC131\\uC790 \u0027 + pr.user.login + \u0027 | \\uB9AC\\uBDF0 \\uB300\\uAE30 *\u0027 + reviewerNames + \u0027*\u0027);\n  teamsLines.push(String(index + 1) + \u0027. \u0027 + pr.title + \u0027\\n\\uC791\\uC131\\uC790: \u0027 + pr.user.login + \u0027\\n\\uB9AC\\uBDF0 \\uB300\\uAE30: \u0027 + reviewerNames + \u0027\\n\\uB9C1\\uD06C: \u0027 + pr.html_url);\n}\n\nreturn [{\n  json: {\n    prCount: validPrs.length,\n    repository: \u0027vmslab/Mozart2.0\u0027,\n    checkTime: nowText,\n    slackText: \u0027\\uD83D\\uDCCC *Pending Pull Requests \\uB9AC\\uD3EC\\uD2B8*\\n\\n\u0027 + slackLines.join(\u0027\\n\\n\u0027),\n    teamsTitle: \u0027GitHub PR \\uBAA8\\uB2C8\\uD130\\uB9C1\u0027,\n    teamsSummary: \u0027\\uB300\\uAE30 \\uC911\\uC778 Pull Request \u0027 + validPrs.length + \u0027\\uAC74\\uC774 \\uC788\\uC2B5\\uB2C8\\uB2E4.\u0027,\n    teamsDetails: teamsLines.join(\u0027\\n\\n\u0027),\n  },\n}];"
