                  {
                      "parameters":  {
                                         "toRecipients":  "={{ $node[\"신입사원 관련 메일 수신\"].json.toRecipients.map(item =\u003e item.emailAddress.address).join(\u0027,\u0027) }}",
                                         "subject":  "=RE: {{ $json.subject }}",
                                         "bodyContent":  "=\u003cdiv style=\"font-size:14px; font-family:\u0027Malgun Gothic\u0027, sans-serif; line-height:1.8;\"\u003e\n\n    \u003cp style=\"margin: 0 0 10px 0;\"\u003e안녕하십니까 기술지원파트입니다.\u003c/p\u003e\n    \n    \u003cp style=\"margin: 0 0 10px 0;\"\u003e우선 입사를 축하 드립니다.\u003c/p\u003e\n\n    \u003cp style=\"margin: 0 0 10px 0;\"\u003e회사 내 시스템을 이용하기 위해서는 몇 가지 시스템에 계정 생성 및 가입이 필요합니다.\u003cbr\u003e\n    수신된 회사 이메일을 계정으로 아래 가이드를 참조하여 회원 가입을 진행 주시기 바랍니다.\u003c/p\u003e\n\n    \u003cp style=\"margin: 15px 0 5px 0;\"\u003e\n        \u003cstrong\u003e\n            1. 신규 입사자 가이드 (\u003ca href=\"https://vmssolutions.notion.site/79132db898854d81acbed7096812b210\"\u003e바로가기\u003c/a\u003e) – 교육 신청과 제품 관련 서비스를 요청을 위한 Support Portal 홈페이지 가입\n        \u003c/strong\u003e\n    \u003c/p\u003e\n    \u003cul style=\"margin: 5px 0 15px 15px; padding: 0;\"\u003e\n        \u003cli\u003eSupport Portal 홈페이지: \u003ca href=\"http://www.vmsmozart.com\"\u003ehttp://www.vmsmozart.com\u003c/a\u003e\u003c/li\u003e\n        \u003cli\u003eSupport Portal 가입 Company Code: \u003cstrong\u003eVMS201401\u003c/strong\u003e\u003c/li\u003e\n        \u003cli\u003e홈페이지 가입 시 이름 입력란 (First Name: 이름, Last Name: 성)에 \u003cstrong\u003e한글\u003c/strong\u003e로 이름을 입력해주시기 바랍니다.\u003c/li\u003e\n    \u003c/ul\u003e\n\n    \u003cp style=\"margin: 15px 0 5px 0;\"\u003e\n        \u003cstrong\u003e\n            2. 노션 온라인 회원 가입 (\u003ca href=\"https://notion.so\"\u003e노션사이트 이동\u003c/a\u003e) 및 가입 이메일 회신 - 온라인 기술문서를 확인하기 위한 노션 가입\n        \u003c/strong\u003e\n    \u003c/p\u003e\n    \u003cul style=\"margin: 5px 0 15px 15px; padding: 0;\"\u003e\n        \u003cli\u003e가입 시 꼭 회사 메일로 계정 생성 부탁드립니다.\u003c/li\u003e\n        \u003cli\u003e가입 후 \u003cstrong style=\"color:#08baff;\"\u003e가입 완료 메일 회신\u003c/strong\u003e 부탁드립니다.\u003c/li\u003e\n    \u003c/ul\u003e\n    \n    \u003cp style=\"margin: 15px 0 10px 0;\"\u003e제품과 관련해서 문의 사항은 기술지원파트로 문의를 주시면 됩니다.\u003cbr\u003e\n    아래 기술지원 제공 서비스 가이드를 참고하여 확인하여 주시기 바랍니다.\u003c/p\u003e\n\n    \u003cul style=\"margin: 5px 0 15px 15px; padding: 0;\"\u003e\n        \u003cli\u003e기술지원 제공 서비스 가이드: \u003ca href=\"https://vmssolutions.notion.site/582c0d58bf934714a31a7daad5fd6f3a\"\u003e바로가기\u003c/a\u003e\u003c/li\u003e\n        \u003cli\u003e\u003cstrong\u003eWindows 및 Visual Studio 다운로드 및 제품 키\u003c/strong\u003e가 신규 입사자 가이드에 포함되어 있습니다.\u003c/li\u003e\n        \u003cli\u003e\u003cstrong\u003eVisual Studio 설치 초기 Mozart Explorer가 보이지 않는 이슈\u003c/strong\u003e가 발생할 경우:\n            \u003ca href=\"https://vmssolutions.notion.site/Visual-Studio-2019-2022-MOZART-Explorer-b7f18a835f5b43eea23a3d9097873052?pvs=143\"\u003e바로가기\u003c/a\u003e\n        \u003c/li\u003e\n    \u003c/ul\u003e\n\n    \u003cp style=\"margin: 15px 0 10px 0;\"\u003e그 외 질문 사항이 있으면 본 메일 (\u003ca href=\"mailto:support@vms-solutions.com\"\u003esupport@vms-solutions.com\u003c/a\u003e)로 회신 문의 주시기 바랍니다.\u003c/p\u003e\n\n    \u003cp style=\"margin: 10px 0 20px 0;\"\u003e감사합니다.\u003c/p\u003e\n\n    \u003chr style=\"border-top: 1px solid #ddd; margin: 20px 0;\"\u003e\n\n    \u003cdiv style=\"font-size:13px; color:#404040; line-height:1.4;\"\u003e\n        \u003cp style=\"margin: 0; padding: 0;\"\u003e\n            \u003cimg src=\"https://ssproxy.ucloudbiz.olleh.com/v1/AUTH_28b3e23f-3839-4260-a4fe-9d324423f8fb/VMSEDU/image001.jpg\" width=\"121\" height=\"41\" alt=\"VMS 로고\"\u003e\n        \u003c/p\u003e\n        \u003cstrong\u003eVMS Solutions Product Support\u003c/strong\u003e\n        \u003cp style=\"margin: 5px 0 0 0; padding: 0;\"\u003e20F-2001, Knowledge Industry Center, Bundang Suji U-Tower Bldg,\u003c/p\u003e\n        \u003cp style=\"margin: 0; padding: 0;\"\u003e767, Shinsu-ro, Suji-gu, Yongin-si, Gyeonggi-do, 16827, Republic of South Korea\u003c/p\u003e\n        \n        \u003cp style=\"margin: 5px 0 0 0; padding: 0;\"\u003e\n            \u003cspan style=\"color:#f28c00; font-weight:bold;\"\u003eT\u003c/span\u003e +82 31 276 4746 |\n            \u003cspan style=\"color:#f28c00; font-weight:bold;\"\u003eF\u003c/span\u003e +82 31 218 4744\n        \u003c/p\u003e\n        \n        \u003cp style=\"margin: 0; padding: 0;\"\u003e\n            \u003cspan style=\"color:#f28c00; font-weight:bold;\"\u003eE\u003c/span\u003e \n            \u003ca href=\"mailto:support@vms-solutions.com\" style=\"color:#404040; text-decoration:none;\"\u003esupport@vms-solutions.com\u003c/a\u003e |\n            \u003cspan style=\"color:#f28c00; font-weight:bold;\"\u003eW\u003c/span\u003e \n            \u003ca href=\"http://www.vmsmozart.com\" style=\"color:#404040; text-decoration:none;\"\u003ewww.vmsmozart.com\u003c/a\u003e\n        \u003c/p\u003e\n    \u003c/div\u003e\n\u003c/div\u003e",
                                         "additionalFields":  {
                                                                  "ccRecipients":  "={{ $json.from.emailAddress.address }}",
                                                                  "bodyContentType":  "html"
                                                              }
                                     },
